{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "qrcartoon-redirects-test",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,

	// Your redirect list lives here. Deploy to Cloudflare creates it for you.
	"kv_namespaces": [{ "binding": "QR","id": "89d616d0b5ff4eb9b574ac56c290ae5d" }],

	"vars": {
		// REQUIRED. Domains your QR codes may send people to, comma separated.
		// "brand.com" also allows its subdomains (shop.brand.com).
		// Redirects anywhere else are refused, even if QRCartoon asks for them.
		"ALLOWED_HOSTS": "google.com"
	}
}
